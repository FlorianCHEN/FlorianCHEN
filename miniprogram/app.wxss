page{min-height:100%;background:#fffefa;color:#211e1a;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:30rpx}button{font:inherit}button::after{border:0}.page{min-height:100vh}.empty{padding:150rpx 32rpx;text-align:center;color:#817a70}.empty-title{display:block;margin-bottom:16rpx;color:#211e1a;font-size:32rpx;font-weight:600}.retry{display:inline-flex;margin-top:28rpx;padding:0 30rpx;height:72rpx;align-items:center;justify-content:center;border:1rpx solid #ded8cf;border-radius:36rpx;background:#fffefa;color:#6b2730;font-size:26rpx}.loading{padding:150rpx 32rpx;text-align:center;color:#817a70;font-size:26rpx}.safe-bottom{height:calc(30rpx + env(safe-area-inset-bottom))}
