<view class="page">
  <view class="topbar" style="padding-top:{{statusBarHeight}}px">
    <text class="brand">開開厨房</text>
    <button class="add-button" bindtap="openEditor" aria-label="新增菜谱">＋</button>
  </view>

  <view class="content">
    <text class="home-title">今天想吃点什么？</text>
    <view class="search-box">
      <text class="search-icon">⌕</text>
      <input value="{{query}}" bindinput="onSearch" placeholder="搜索菜谱或食材" confirm-type="search" />
      <button wx:if="{{query}}" class="clear" bindtap="clearSearch">×</button>
    </view>

    <scroll-view class="filters" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filter-row">
        <button wx:for="{{categories}}" wx:key="*this" class="filter {{category === item ? 'active' : ''}}" data-category="{{item}}" bindtap="chooseCategory">{{item}}</button>
      </view>
    </scroll-view>

    <text wx:if="{{cloudNotice}}" class="cloud-notice">{{cloudNotice}}</text>

    <view wx:if="{{loading}}" class="loading">正在读取菜单…</view>
    <view wx:elif="{{error}}" class="empty"><text class="empty-title">菜单暂时无法打开</text><text>{{error}}</text><button class="retry" bindtap="retryLoad">重新加载</button></view>
    <view wx:elif="{{!visible.length}}" class="empty"><text class="empty-title">没有找到相关菜品</text><button class="retry" bindtap="clearSearch">查看全部</button></view>
    <block wx:else>
      <view class="waterfall">
        <view wx:for="{{visible}}" wx:key="id" class="dish-card" data-id="{{item.id}}" bindtap="openDish">
          <image wx:if="{{item.hasImage}}" class="dish-image" src="{{item.image}}" mode="aspectFill" lazy-load />
          <view wx:else class="dish-image image-placeholder"><text>{{isAdmin ? '添加图片' : '暂无图片'}}</text></view>
          <text class="dish-name">{{item.name}}</text>
          <text class="ingredients">{{item.ingredientText}}</text>
        </view>
      </view>
      <view wx:if="{{totalPages > 1}}" class="pager">
        <button class="page-button" disabled="{{page === 1}}" bindtap="previousPage">‹ 上一页</button>
        <text>{{page}} / {{totalPages}}</text>
        <button class="page-button" disabled="{{page === totalPages}}" bindtap="nextPage">下一页 ›</button>
      </view>
    </block>
  </view>

  <view class="safe-bottom"></view>
</view>
