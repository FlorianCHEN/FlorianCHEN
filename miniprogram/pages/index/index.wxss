.topbar{position:sticky;top:0;z-index:20;min-height:92rpx;padding-left:38rpx;padding-right:30rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid rgba(107,39,48,.08);background:rgba(255,254,250,.97);box-sizing:content-box}.brand{font-family:"Songti SC","STSong",serif;font-size:38rpx;font-weight:600;letter-spacing:1rpx}.add-button{width:64rpx;height:64rpx;padding:0;background:transparent;color:#6b2730;font-size:44rpx;font-weight:300;line-height:64rpx}.content{padding:42rpx 36rpx 0}.home-title{display:block;margin-bottom:32rpx;font-family:"Songti SC","STSong",serif;font-size:48rpx;font-weight:600;line-height:1.3}.search-box{height:80rpx;display:flex;align-items:center;gap:12rpx;padding:0 20rpx;border-radius:18rpx;background:#f3f0eb;color:#817a70}.search-box input{flex:1;height:80rpx;font-size:27rpx}.search-icon{font-size:31rpx}.clear{width:48rpx;height:48rpx;padding:0;background:transparent;color:#817a70;font-size:30rpx}.filters{width:100%;margin:24rpx 0 34rpx;white-space:nowrap}.filter-row{display:inline-flex;gap:40rpx;padding-right:30rpx}.filter{position:relative;height:66rpx;padding:0;background:transparent;color:#817a70;font-size:26rpx;line-height:66rpx}.filter.active{color:#6b2730;font-weight:600}.filter.active::after{content:"";position:absolute;left:50%;bottom:1rpx;width:30rpx;height:3rpx;background:#6b2730;transform:translateX(-50%)}.cloud-notice{display:block;margin:-14rpx 0 28rpx;color:#9b514f;font-size:22rpx;line-height:1.55}.waterfall{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:28rpx;row-gap:46rpx}.dish-card{min-width:0}.dish-image{display:block;width:100%;height:auto;aspect-ratio:4/5;border-radius:18rpx;background:#eeeae4}.image-placeholder{display:flex;align-items:center;justify-content:center;color:#9a9389;font-size:23rpx}.dish-name{display:block;margin-top:16rpx;font-size:29rpx;font-weight:600;line-height:1.4}.ingredients{display:-webkit-box;margin-top:6rpx;overflow:hidden;color:#8d867c;font-size:22rpx;line-height:1.55;-webkit-line-clamp:2;-webkit-box-orient:vertical}.pager{margin:54rpx 0 10rpx;display:flex;align-items:center;justify-content:space-between;color:#817a70;font-size:23rpx}.page-button{min-width:170rpx;height:70rpx;padding:0;background:transparent;color:#6b2730;font-size:24rpx}.page-button[disabled]{opacity:.3}
