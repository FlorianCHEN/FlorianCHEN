.topbar{position:sticky;top:0;z-index:20;height:104rpx;padding:0 24rpx;display:grid;grid-template-columns:72rpx 1fr 72rpx;align-items:center;border-bottom:1rpx solid #ded8cf;background:rgba(255,254,250,.96)}.brand{text-align:center;font-size:34rpx;font-weight:650}.icon-button,.add-button{width:72rpx;height:72rpx;padding:0;background:transparent}.menu-button{display:flex;flex-direction:column;justify-content:center;gap:8rpx}.menu-button view{width:34rpx;height:3rpx;border-radius:2rpx;background:#211e1a}.add-button{color:#6b2730;font-size:50rpx;font-weight:300}.content{padding:22rpx 16rpx 0}.search-box{height:78rpx;margin:0 8rpx;display:flex;align-items:center;gap:12rpx;padding:0 22rpx;border-radius:22rpx;background:#f3f0eb;color:#817a70}.search-box input{flex:1;height:78rpx;font-size:26rpx}.search-icon{font-size:36rpx}.clear{width:50rpx;height:50rpx;padding:0;background:transparent;color:#817a70;font-size:32rpx}.filters{width:100%;margin:18rpx 0 24rpx;white-space:nowrap}.filter-row{display:inline-flex;gap:12rpx;padding:0 8rpx}.filter{height:56rpx;padding:0 22rpx;border-radius:28rpx;background:#eee8df;color:#5f594f;font-size:23rpx;line-height:56rpx}.filter.active{background:#6b2730;color:#fff}.waterfall{column-count:2;column-gap:14rpx}.dish-card{display:inline-block;width:100%;margin-bottom:26rpx;break-inside:avoid}.dish-image{display:block;width:100%;height:auto;border-radius:14rpx;background:#ece7df}.dish-name{display:block;margin:14rpx 8rpx 0;font-size:28rpx;font-weight:650;line-height:1.4}.card-meta{margin:12rpx 8rpx 0;padding-top:10rpx;display:flex;justify-content:space-between;border-top:1rpx solid #eeeae4;color:#918a80;font-size:20rpx}.pager{margin:34rpx 8rpx 8rpx;display:flex;align-items:center;justify-content:space-between;color:#817a70;font-size:23rpx}.page-button{min-width:184rpx;height:76rpx;padding:0 26rpx;border:1rpx solid #ded8cf;border-radius:38rpx;background:#f3f1ed;color:#6b2730;font-size:24rpx}.page-button[disabled]{opacity:.35}.drawer-mask{position:fixed;inset:0;z-index:60;background:rgba(33,30,26,.28)}.drawer{width:510rpx;height:100%;padding:38rpx 24rpx;background:#fffefa;box-shadow:24rpx 0 60rpx rgba(33,30,26,.14)}.drawer-head{height:92rpx;padding:0 12rpx;display:flex;align-items:center;justify-content:space-between;font-size:38rpx;font-weight:700}.drawer-head button{width:70rpx;height:70rpx;padding:0;background:transparent;color:#817a70;font-size:38rpx}.drawer-item{width:100%;height:84rpx;padding:0 24rpx;border-radius:14rpx;background:transparent;text-align:left;color:#211e1a;font-size:28rpx}.drawer-item.active{background:#f2e9e5;color:#6b2730;font-weight:650}.drawer-actions{margin:28rpx 18rpx 0;padding-top:20rpx;border-top:1rpx solid #ded8cf}.drawer-actions button{width:100%;height:82rpx;padding:0;background:transparent;text-align:left;color:#6b2730;font-size:28rpx}
