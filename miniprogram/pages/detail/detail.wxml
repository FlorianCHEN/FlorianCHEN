<view class="page">
  <view wx:if="{{loading}}" class="loading">正在读取菜谱…</view>
  <view wx:elif="{{!dish}}" class="empty"><text class="empty-title">菜品不存在</text></view>
  <block wx:else>
    <image wx:if="{{dish.hasImage}}" class="hero" src="{{dish.image}}" mode="aspectFill" />
    <view wx:else class="hero hero-placeholder"><text>{{isAdmin ? '添加图片' : '暂无图片'}}</text></view>
    <view class="body">
      <text class="name">{{dish.name}}</text>
      <text wx:if="{{dish.description}}" class="description">{{dish.description}}</text>
      <view class="section">
        <text class="section-title">食材</text>
        <view class="ingredient-list">
          <button wx:for="{{ingredients}}" wx:key="name" class="ingredient {{item.linked ? '' : 'plain'}}" data-name="{{item.name}}" data-linked="{{item.linked}}" bindtap="openRelated"><text>{{item.name}}</text><text wx:if="{{item.linked}}" class="chevron">›</text></button>
        </view>
      </view>
      <view wx:if="{{isAdmin}}" class="admin-actions">
        <button class="primary" bindtap="editDish">修改菜品</button>
        <button bindtap="replaceImage">更换图片</button>
        <button wx:if="{{dish.imagePath}}" bindtap="restoreImage">恢复原图</button>
        <button class="danger" bindtap="deleteDish">删除</button>
      </view>
    </view>
    <view class="safe-bottom"></view>
  </block>
</view>
