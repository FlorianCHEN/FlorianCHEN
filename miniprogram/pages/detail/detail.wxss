.hero{display:block;width:calc(100% - 36rpx);height:520rpx;margin:18rpx;border-radius:22rpx;background:#ece7df}.body{padding:24rpx 30rpx 0}.name{display:block;font-size:52rpx;font-weight:700;line-height:1.25}.tags{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:22rpx}.tags text{padding:12rpx 20rpx;border-radius:26rpx;background:#eee8df;color:#5f594f;font-size:22rpx}.description{display:block;margin-top:28rpx;color:#817a70;font-size:27rpx;line-height:1.75}.section{margin-top:48rpx}.section-title{font-size:34rpx;font-weight:650}.ingredient-list{margin-top:20rpx;border-top:1rpx solid #ded8cf}.ingredient{width:100%;height:92rpx;padding:0 4rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #ded8cf;border-radius:0;background:transparent;text-align:left;font-size:28rpx}.ingredient.plain{color:#817a70}.chevron{color:#817a70;font-size:42rpx}.admin-actions{margin-top:38rpx;display:flex;flex-wrap:wrap;gap:14rpx}.admin-actions button{height:72rpx;padding:0 24rpx;border:1rpx solid #ded8cf;border-radius:36rpx;background:#fffefa;color:#5f594f;font-size:24rpx}.admin-actions .primary{border-color:#6b2730;background:#6b2730;color:#fff}.admin-actions .danger{border-color:transparent;color:#9b514f}
