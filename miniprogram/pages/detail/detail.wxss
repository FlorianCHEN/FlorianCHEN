.hero{display:block;width:calc(100% - 72rpx);height:auto;aspect-ratio:4/5;margin:28rpx 36rpx 0;border-radius:22rpx;background:#eeeae4}.hero-placeholder{display:flex;align-items:center;justify-content:center;color:#9a9389;font-size:24rpx}.body{padding:34rpx 36rpx 0}.name{display:block;font-family:"Songti SC","STSong",serif;font-size:54rpx;font-weight:600;line-height:1.25}.description{display:block;margin-top:20rpx;color:#817a70;font-size:27rpx;line-height:1.75}.section{margin-top:52rpx}.section-title{font-size:33rpx;font-weight:600}.ingredient-list{margin-top:18rpx;border-top:1rpx solid #e5dfd7}.ingredient{width:100%;height:92rpx;padding:0 2rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #e5dfd7;border-radius:0;background:transparent;text-align:left;font-size:28rpx}.ingredient.plain{color:#817a70}.chevron{color:#817a70;font-size:36rpx}.admin-actions{margin-top:42rpx;padding-top:18rpx;border-top:1rpx solid #e5dfd7;display:grid;grid-template-columns:1fr 1fr;gap:8rpx 20rpx}.admin-actions button{height:72rpx;padding:0;background:transparent;color:#5f594f;font-size:25rpx;text-align:left}.admin-actions .primary{color:#6b2730;font-weight:600}.admin-actions .danger{color:#9b514f}
