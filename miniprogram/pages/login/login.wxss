.login-page{min-height:100vh;padding:96rpx 42rpx;background:#fffefa}.login-card{padding:0;background:transparent}.title{display:block;font-family:"Songti SC","STSong",serif;font-size:46rpx;font-weight:600}.hint{display:block;margin:14rpx 0 46rpx;color:#817a70;font-size:24rpx;line-height:1.6}.login-card label{display:block;margin-top:30rpx;color:#5f594f;font-size:24rpx}.login-card input{height:88rpx;margin-top:10rpx;padding:0 2rpx;border:0;border-bottom:1rpx solid #ded8cf;border-radius:0;background:transparent;color:#211e1a;font-size:28rpx}.submit{height:86rpx;margin-top:50rpx;border-radius:12rpx;background:#6b2730;color:#fff;font-size:28rpx}
