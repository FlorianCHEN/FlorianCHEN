.login-page{min-height:100vh;padding:80rpx 34rpx;background:#fffefa}.login-card{padding:42rpx 34rpx;border:1rpx solid #ded8cf;border-radius:24rpx;background:#fffdfa}.title{display:block;font-size:44rpx;font-weight:700}.hint{display:block;margin:14rpx 0 38rpx;color:#817a70;font-size:24rpx;line-height:1.6}.login-card label{display:block;margin-top:26rpx;color:#5f594f;font-size:24rpx}.login-card input{height:88rpx;margin-top:12rpx;padding:0 22rpx;border:1rpx solid #ded8cf;border-radius:14rpx;background:#fffefa;color:#211e1a;font-size:28rpx}.submit{height:88rpx;margin-top:40rpx;border-radius:44rpx;background:#6b2730;color:#fff;font-size:28rpx}
