.related-page{padding:38rpx 36rpx 0}.intro{padding:4rpx 0 38rpx}.title{display:block;font-family:"Songti SC","STSong",serif;font-size:52rpx;font-weight:600}.count{display:block;margin-top:10rpx;color:#817a70;font-size:24rpx}.waterfall{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:28rpx;row-gap:46rpx}.dish-card{min-width:0}.dish-image{display:block;width:100%;height:auto;aspect-ratio:4/5;border-radius:18rpx;background:#eeeae4}.image-placeholder{display:flex;align-items:center;justify-content:center;color:#9a9389;font-size:23rpx}.dish-name{display:block;margin-top:16rpx;font-size:29rpx;font-weight:600;line-height:1.4}.ingredients{display:-webkit-box;margin-top:6rpx;overflow:hidden;color:#8d867c;font-size:22rpx;line-height:1.55;-webkit-line-clamp:2;-webkit-box-orient:vertical}
