<view class="page related-page">
  <view class="intro"><text class="title">{{ingredient}}</text><text class="count">{{dishes.length}} 道相关菜品</text></view>
  <view wx:if="{{loading}}" class="loading">正在读取菜单…</view>
  <view wx:elif="{{!dishes.length}}" class="empty"><text class="empty-title">暂无相关菜品</text></view>
  <view wx:else class="waterfall">
    <view wx:for="{{dishes}}" wx:key="id" class="dish-card" data-id="{{item.id}}" bindtap="openDish">
      <image wx:if="{{item.hasImage}}" class="dish-image" src="{{item.image}}" mode="aspectFill" lazy-load />
      <view wx:else class="dish-image image-placeholder"><text>暂无图片</text></view>
      <text class="dish-name">{{item.name}}</text>
      <text class="ingredients">{{item.ingredientText}}</text>
    </view>
  </view>
  <view class="safe-bottom"></view>
</view>
