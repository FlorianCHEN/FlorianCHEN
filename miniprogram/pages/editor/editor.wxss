.editor-page{padding:28rpx 36rpx 0}.image-picker{width:100%;height:auto;aspect-ratio:4/3;padding:0;border-radius:20rpx;background:#f2eee8;color:#817a70;font-size:26rpx;overflow:hidden}.image-picker image{width:100%;height:100%}.editor-page label{display:block;margin-top:36rpx;color:#211e1a;font-size:25rpx;font-weight:600}.editor-page input,.editor-page textarea,.picker-value{width:100%;margin-top:12rpx;padding:0 4rpx;border:0;border-bottom:1rpx solid #ded8cf;border-radius:0;background:transparent;color:#211e1a;font-size:28rpx;font-weight:400;box-sizing:border-box}.editor-page input,.picker-value{height:84rpx;line-height:84rpx}.editor-page textarea{height:160rpx;padding-top:18rpx}.picker-value{display:flex;align-items:center;justify-content:space-between}.picker-value text{color:#817a70;font-size:34rpx}.note{display:block;margin-top:12rpx;color:#817a70;font-size:22rpx}.save{height:86rpx;margin-top:48rpx;border-radius:12rpx;background:#6b2730;color:#fff;font-size:28rpx}
